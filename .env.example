# SentinelScan Environment Configuration Template
# Copy this file to .env for local overrides.
# Default zero-cost settings work out of the box without any external services.

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Storage Provider Configuration: 'local' (default, $0 cost) or 'b2'
STORAGE_PROVIDER=local
LOCAL_TEMP_DIR=./temp/uploads

# Backblaze B2 Object Storage (Optional - leave empty for local $0 storage)
# Obtain from: https://www.backblaze.com/b2/cloud-storage.html
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=

# ClamAV Antivirus Daemon (Optional - if not running, will report 'Antivirus engine unavailable')
# Default local clamd port is 3310
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Database Configuration (SQLite file location)
DATABASE_PATH=./data/sentinelscan.sqlite

# File Lifecycle Policies (in minutes)
SCAN_FILE_RETENTION_MINUTES=5
CLEANUP_INTERVAL_SECONDS=60

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Optional Threat Intelligence API Key (Optional - will report 'Threat intelligence unavailable' if empty)
OPTIONAL_THREAT_INTEL_API_KEY=
